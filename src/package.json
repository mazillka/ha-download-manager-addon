{
  "name": "ha-download-manager",
  "version": "1.0.27",
  "type": "module",
  "description": "Home Assistant Download Manager Add-on",
  "main": "backend/server.ts",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --watch backend --ext ts,json --exec \"node ./backend/esbuild.config.ts && node ./dist/backend/server.js\"",
    "dev:frontend": "webpack --config ./frontend/webpack.config.ts --watch --mode development",
    "build:dev": "npm run build:backend && npm run build:frontend:dev",
    "build:prod": "npm run build:frontend:prod && npm run build:backend",
    "build:backend": "node ./backend/esbuild.config.ts",
    "build:frontend:dev": "webpack --config ./frontend/webpack.config.ts --mode development",
    "build:frontend:prod": "webpack --config ./frontend/webpack.config.ts --mode production"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "playwright": "^1.57.0",
    "sqlite3": "^5.1.7",
    "sweetalert2": "^11.26.17",
    "video.js": "^8.23.4",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.8",
    "@types/sqlite3": "^5.1.0",
    "@vue/compiler-sfc": "^3.5.26",
    "@vue/runtime-dom": "^3.5.26",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "html-webpack-plugin": "^5.6.5",
    "nodemon": "^3.1.11",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vue-loader": "^17.4.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
